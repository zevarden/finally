# Copy this file to .env and fill in.
# Write values WITHOUT quotes (KEY=value, not KEY="value"): docker --env-file keeps quotes literally.

# Required: LiteLLM key for the AI chat
LITELLM_MASTER_KEY=

# Two modes: LITELLM_API_BASE empty -> chat calls xAI directly with LITELLM_MASTER_KEY;
# LITELLM_API_BASE set -> chat goes through that LiteLLM proxy using LITELLM_API_KEY (falls back to LITELLM_MASTER_KEY).
# Optional: LiteLLM proxy base URL (empty = call xAI directly). A localhost URL such as
# http://localhost:4000 also works in Docker: the container rewrites it to host.docker.internal.
LITELLM_API_BASE=

# Optional: LiteLLM proxy virtual key (proxy mode only; empty = use LITELLM_MASTER_KEY)
LITELLM_API_KEY=

# Optional: LLM model id; leave empty for the default (xai/grok-4.7)
LLM_MODEL=

# Optional: Massive (Polygon.io) API key for real market data.
# Empty -> built-in market simulator (recommended for most users).
MASSIVE_API_KEY=

# Optional: seconds between Massive snapshot polls (free tier: 15; paid tiers can go to 2)
MASSIVE_POLL_INTERVAL=15

# Optional: fixed RNG seed for the simulator (deterministic prices for tests/demos)
MARKET_SIM_SEED=

# Optional: "true" (or 1/yes/on) for deterministic mock LLM responses (E2E tests)
LLM_MOCK=false

# Optional: override the SQLite file location (default: db/finally.db; /app/db/finally.db in Docker)
# DB_PATH=

# Optional: override the directory of the static frontend export (default: backend/static)
# STATIC_DIR=
