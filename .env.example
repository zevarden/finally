# Required: LiteLLM key for the AI chat (copy this file to .env and fill in)
LITELLM_MASTER_KEY=

# Optional: Massive (Polygon.io) API key for real market data.
# Empty -> built-in market simulator (recommended for most users).
MASSIVE_API_KEY=

# Optional: seconds between Massive snapshot polls (free tier: 15; paid tiers can go to 2)
MASSIVE_POLL_INTERVAL=15

# Optional: fixed RNG seed for the simulator (deterministic prices for tests/demos)
MARKET_SIM_SEED=

# Optional: "true" for deterministic mock LLM responses (E2E tests)
LLM_MOCK=false
